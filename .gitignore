.venv/
__pycache__/
*.pyc

# PyInstaller: build output is generated, but vibecheck.spec is our build
# definition and must be tracked.
build/
dist/
*.spec
!vibecheck.spec

# Maintainer-local Claude Code notes: preferences, live-prod gotchas, brand
# source files. Never published — it has its own private repo (nested git
# checkout) so nothing here is lost, without any of it landing in the public
# history. CLAUDE.md itself is tracked: it's project context with no secrets in
# it, and contributors need it.
.claude/

# Build-time backend credentials (publishable key baked into releases).
# Generated by the release build — never committed. See docs/RELEASE.md.
vibecheck/_bundled.py
